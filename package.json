{
  "name": "crawler-snapshot",
  "version": "0.1.0",
  "description": "Snapshot JavaScript-rendered pages with your own Chrome, check what crawlers actually see, and serve the snapshot to AI and search bots.",
  "type": "module",
  "license": "MIT",
  "author": "Reidify (https://reidify.design)",
  "homepage": "https://github.com/reidifydesign/crawler-snapshot#readme",
  "repository": {
    "type": "git",
    "url": "git+https://github.com/reidifydesign/crawler-snapshot.git"
  },
  "bugs": {
    "url": "https://github.com/reidifydesign/crawler-snapshot/issues"
  },
  "bin": {
    "crawler-snapshot": "./bin/crawler-snapshot.js"
  },
  "exports": {
    ".": "./src/index.js",
    "./serve": "./src/serve.js",
    "./crawlers.json": "./data/crawlers.json",
    "./package.json": "./package.json"
  },
  "files": [
    "bin",
    "src",
    "data",
    "examples",
    "README.md",
    "LICENSE"
  ],
  "engines": {
    "node": ">=18.3"
  },
