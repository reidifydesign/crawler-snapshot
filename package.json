  },
  "keywords": [
    "prerender",
    "prerendering",
    "spa",
    "seo",
    "aeo",
    "geo",
    "ai-crawlers",
    "gptbot",
    "claudebot",
    "perplexitybot",
    "headless-chrome",
    "playwright",
    "dynamic-rendering",
    "snapshot",
    "json-ld"
  ],
  "dependencies": {
    "playwright-core": "^1.63.0"
  },
  "devDependencies": {
    "express": "^4.22.3"
  }
}
